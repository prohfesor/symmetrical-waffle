# Copy to .env and fill in for a real deployment. With none of this set, the
# server runs fine for local development: it falls back to a dev-only stub
# login (see /api/auth/dev-login) instead of real Google sign-in.

# --- Google OAuth (leave unset to use the dev-login stub) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (APIs & Services > Credentials > Create Credentials > OAuth client ID >
# Web application). Add PUBLIC_SERVER_URL + "/api/auth/google/callback" as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URLs ---
# Where the frontend is served from (used for CORS + post-login redirects).
# Leave unset for the common case where this server also serves the built UI
# itself (Docker, `npm run start:web`) -- it then defaults to PUBLIC_SERVER_URL
# (its own origin), so login redirects land back on the same port. Only set
# this if the UI is served from a *different* origin than this server, e.g.
# the split dev setup (`npm run dev:web` sets this to :5173 for you already).
FRONTEND_URL=
# The public URL of this server itself (used to build the OAuth callback URL,
# and as the default FRONTEND_URL above).
PUBLIC_SERVER_URL=http://localhost:8787

# --- Session ---
# Any long random string. Required for real deployments (sessions are signed
# with this); without it the server uses an insecure default and warns.
SESSION_SECRET=

# --- Misc ---
PORT=8787
# Path to the SQLite database file.
DB_PATH=./data/pcad.sqlite
NODE_ENV=development
