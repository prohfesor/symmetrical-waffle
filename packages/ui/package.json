{
  "name": "@wafflecad/ui",
  "version": "0.1.0",
  "private": true,
  "description": "React + Canvas2D drawing editor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prohfesor/symmetrical-waffle.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "build:pages": "cross-env VITE_STORAGE=local vite build --outDir dist-pages"
  },
  "dependencies": {
    "@wafflecad/core": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "cross-env": "^7.0.3"
  }
}
