{
  "name": "parametric-cad",
  "private": true,
  "version": "0.1.0",
  "description": "Parametric 2D CAD drawing tool with text-file-driven equations, DXF export, and tiled scaled printing",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:ui": "npm run dev --workspace=@pcad/ui",
    "dev:desktop": "npm run dev --workspace=@pcad/desktop"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
